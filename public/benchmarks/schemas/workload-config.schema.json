{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satelliteinference.com/benchmarks/schemas/workload-config.schema.json",
  "title": "Satellite Inference workload configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configVersion",
    "workloadId",
    "title",
    "programRole",
    "inputModality",
    "task",
    "decisionOutput",
    "evidenceState",
    "firstFlightCandidate",
    "dataset",
    "model",
    "adapter",
    "metrics",
    "prohibitedClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "configVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "workloadId": { "enum": ["optical-quality", "wildfire-change", "sar-vessel-detection"] },
    "title": { "type": "string", "minLength": 1 },
    "programRole": { "enum": ["PRIMARY_BENCHMARK_CANDIDATE", "SECONDARY_BENCHMARK_CANDIDATE", "CONTROL_WORKLOAD"] },
    "inputModality": { "enum": ["OPTICAL_IMAGERY", "SAR_IMAGERY"] },
    "task": { "enum": ["QUALITY_SCREENING", "WILDFIRE_AND_CHANGE_DETECTION", "VESSEL_DETECTION"] },
    "decisionOutput": { "type": "string", "minLength": 1 },
    "evidenceState": { "const": "PENDING_MEASUREMENT" },
    "firstFlightCandidate": { "type": "boolean" },
    "dataset": { "$ref": "#/$defs/pendingDependency" },
    "model": { "$ref": "#/$defs/pendingDependency" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "implementationStatus"],
      "properties": {
        "contract": { "const": "../lib/workload-adapter.mjs" },
        "implementationStatus": { "const": "PENDING_MEASUREMENT" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsedTime", "inputBytes", "outputBytes", "energy", "temperature", "taskScore"],
      "properties": {
        "elapsedTime": { "$ref": "#/$defs/metricDefinition" },
        "inputBytes": { "$ref": "#/$defs/metricDefinition" },
        "outputBytes": { "$ref": "#/$defs/metricDefinition" },
        "energy": { "$ref": "#/$defs/metricDefinition" },
        "temperature": { "$ref": "#/$defs/metricDefinition" },
        "taskScore": { "$ref": "#/$defs/metricDefinition" }
      }
    },
    "prohibitedClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "pendingDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestTemplate", "selectionStatus"],
      "properties": {
        "manifestTemplate": { "type": "string", "pattern": "^\\.\\./templates/[a-z-]+\\.template\\.json$" },
        "selectionStatus": { "const": "PENDING_MEASUREMENT" }
      }
    },
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "unit", "evidenceState"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "evidenceState": { "const": "PENDING_MEASUREMENT" }
      }
    }
  }
}
