{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satelliteinference.com/benchmarks/schemas/dataset-manifest.schema.json",
  "title": "Satellite Inference dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetManifestId", "version", "status", "title", "description", "modality", "source", "artifacts", "labels", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetManifestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-template)?$" },
    "status": { "enum": ["PENDING_MEASUREMENT", "VERIFIED_INPUT"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "modality": { "type": ["string", "null"], "enum": ["OPTICAL_IMAGERY", "SAR_IMAGERY", null] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "license", "acquiredAt", "sha256"],
      "properties": {
        "uri": { "type": ["string", "null"], "format": "uri" },
        "license": { "type": ["string", "null"] },
        "acquiredAt": { "type": ["string", "null"], "format": "date-time" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "sha256", "sampleCount"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sampleCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomyUri", "annotationProtocol", "reviewStatus"],
      "properties": {
        "taxonomyUri": { "type": ["string", "null"], "format": "uri" },
        "annotationProtocol": { "type": ["string", "null"] },
        "reviewStatus": { "enum": ["PENDING_MEASUREMENT", "VERIFIED_INPUT"] }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PENDING_MEASUREMENT" } }, "required": ["status"] },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "uri": { "type": "null" },
              "license": { "type": "null" },
              "acquiredAt": { "type": "null" },
              "sha256": { "type": "null" }
            }
          },
          "artifacts": { "maxItems": 0 },
          "labels": { "properties": { "reviewStatus": { "const": "PENDING_MEASUREMENT" } } }
        }
      }
    }
  ]
}
